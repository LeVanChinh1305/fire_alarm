# Console
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=n

# ==================== Bluetooth ====================
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y

# Bluedroid Options
CONFIG_BT_GATTS_ENABLE=y
CONFIG_BT_GATTC_ENABLE=y
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_BT_BLE_50_FEATURES_SUPPORTED=y
CONFIG_BT_BLE_SMP_ENABLE=y

# ==================== BLE Mesh ====================
CONFIG_BLE_MESH=y
CONFIG_BLE_MESH_BLUEDROID_HOST=y
CONFIG_BLE_MESH_NODE=y
CONFIG_BLE_MESH_PROV=y
CONFIG_BLE_MESH_CFG_SRV=y
CONFIG_BLE_MESH_GATT_PROXY_SERVER=y
# CONFIG_BLE_MESH_GATT_PROXY_CLIENT is not set
CONFIG_BLE_MESH_RELAY=n
CONFIG_BLE_MESH_FRIEND=n
CONFIG_BLE_MESH_LOW_POWER=n

# Tắt các Client model chưa dùng
CONFIG_BLE_MESH_CFG_CLI=n
CONFIG_BLE_MESH_HEALTH_CLI=n
CONFIG_BLE_MESH_GENERIC_ONOFF_CLI=n
CONFIG_BLE_MESH_GENERIC_LEVEL_CLI=n
CONFIG_BLE_MESH_LIGHT_LIGHTNESS_CLI=n
CONFIG_BLE_MESH_LIGHT_CTL_CLI=n


CONFIG_BLE_MESH_PB_GATT=y
